{
  "schemaVersion": 1,
  "defaultPlatforms": [
    "macos",
    "windows"
  ],
  "records": [
    {
      "id": "temporary-image",
      "kind": "image"
    },
    {
      "id": "temporary-text",
      "kind": "text"
    },
    {
      "id": "temporary-link",
      "kind": "link"
    },
    {
      "id": "saved-once",
      "kind": "text",
