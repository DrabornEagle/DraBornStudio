  "invariants": [
    "Preserve every saved record and all organization",
    "Preserve managed media and external originals",
    "Never include later copies or newly saved records",
    "One recoverable Trash transaction",
    "Cancel performs no writes",
    "Restoring Trash preserves identities and content",
