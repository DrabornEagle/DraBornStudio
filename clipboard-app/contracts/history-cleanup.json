      ]
    },
    {
      "id": "text-only",
      "kind": "text",
      "captured": [
        "temporary-text"
      ],
      "trashed": [
        "temporary-text"
      ]
    },
    {
      "id": "links-only",
      "kind": "link",
      "captured": [
        "temporary-link"
      ],
      "trashed": [
        "temporary-link"
      ]
    },
    {
      "id": "saved-during-confirmation-and-later-copy",
      "kind": "all",
      "captured": [
